<Application x:Class="AltAccounts.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Popup colours. Theme.cs replaces these at runtime (light/dark). -->
            <SolidColorBrush x:Key="PopupBackground" Color="#1E5FD6" />
            <SolidColorBrush x:Key="PopupTitleBar" Color="#184FB5" />
            <SolidColorBrush x:Key="PopupRowHover" Color="#2A6CE0" />
            <SolidColorBrush x:Key="PopupRowSelected" Color="#3B7BEA" />
            <SolidColorBrush x:Key="PopupText" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PopupSubText" Color="#D6E4FF" />
            <SolidColorBrush x:Key="PopupButton" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PopupButtonText" Color="#1E5FD6" />
            <SolidColorBrush x:Key="PopupGhostButton" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="DangerText" Color="#C42B1C" />
            <SolidColorBrush x:Key="MutedText" Color="#6B6B6B" />

            <Style x:Key="PopupTextButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource PopupButtonText}" />
                <Setter Property="Background" Value="{DynamicResource PopupButton}" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PopupGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource PopupTextButton}">
                <Setter Property="Background" Value="{DynamicResource PopupGhostButton}" />
                <Setter Property="Foreground" Value="{DynamicResource PopupText}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>

            <Style x:Key="TitleBarButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource PopupText}" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="34" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,12,0,6" />
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Opacity" Value="0.75" />
                <Setter Property="Margin" Value="0,4,0,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
