<Window x:Class="AltAccounts.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alt Account Switcher - Settings" Width="980" Height="720" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/AltAccounts.ico">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="14,6" BorderThickness="0,1,0,0" BorderBrush="#22808080">
            <TextBlock x:Name="StatusText" Text="Ready." TextTrimming="CharacterEllipsis" />
        </Border>

        <TabControl x:Name="Tabs" Margin="10,10,10,4" SelectionChanged="Tabs_SelectionChanged">

            <!-- ================= Accounts ================= -->
            <TabItem Header="Accounts">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="330" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Add account… (UAC)" Click="AddAccount_Click" Margin="0,0,8,0" />
                            <Button Content="Refresh" Click="Refresh_Click" />
                        </StackPanel>
                        <ListView x:Name="AccountsList" SelectionMode="Single" SelectionChanged="AccountsList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Account" Width="150" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Type" Width="70" DisplayMemberBinding="{Binding Type}" />
                                    <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding Status}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="AccountDetails" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="56" Height="56" Margin="0,0,14,0">
                                    <Ellipse x:Name="DetailAvatar" Fill="#1E5FD6" />
                                    <TextBlock x:Name="DetailInitials" Foreground="White" FontSize="20" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse x:Name="DetailPicture" Visibility="Collapsed" />
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DetailName" FontSize="18" FontWeight="SemiBold" Text="Select an account" />
                                    <TextBlock x:Name="DetailSub" Opacity="0.75" />
                                </StackPanel>
                            </StackPanel>

                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Edit name or type… (UAC)" Click="EditAccount_Click" Margin="0,0,8,8" />
                                <Button x:Name="RemoveButton" Content="Remove… (UAC)" Click="RemoveAccount_Click" Margin="0,0,8,8" />
                                <Button x:Name="SignOutButton" Content="Sign out (UAC)" Click="SignOut_Click" Margin="0,0,8,8" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button Content="Change password…" Click="ChangePassword_Click" Margin="0,0,8,8" />
                                <Button Content="Change PIN…" Click="ChangePin_Click" Margin="0,0,8,8" />
                                <Button Content="Change picture…" Click="ChangePicture_Click" Margin="0,0,8,8" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="This app never sees, stores or shows passwords or PINs. These buttons open the official Windows pages. A PIN and the account picture can only be changed by the account's own user, while signed in as themselves." />

                            <TextBlock Text="Options for this account" Style="{StaticResource SectionHeader}" />
                            <CheckBox x:Name="HideBox" Content="Hide from the Alt popup (the Windows sign-in screen still shows it)" Margin="0,4" />
                            <CheckBox x:Name="DisableBox" Content="Don't run Alt Account Switcher in this account" Margin="0,4" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Card colour" VerticalAlignment="Center" />
                                <ComboBox x:Name="AccentBox" Grid.Column="1" Margin="0,4" Width="220" HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="1" Text="Lock after idle (minutes)" VerticalAlignment="Center" />
                                <TextBox x:Name="IdleBox" Grid.Row="1" Grid.Column="1" Margin="0,4" Width="120" HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="2" Text="Daily time limit (minutes)" VerticalAlignment="Center" />
                                <TextBox x:Name="DailyBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Width="120" HorizontalAlignment="Left" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Hint}"
                                           Text="Warning 5 minutes before, then the PC locks. Enforced by this app only, so a determined user can close it." />

                                <TextBlock Grid.Row="4" Text="Allowed sign-in hours" VerticalAlignment="Center" />
                                <TextBox x:Name="HoursBox" Grid.Row="4" Grid.Column="1" Margin="0,4" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Hint}"
                                           Text="Example: M-F,08:00-20:00;Sa-Su,10:00-18:00 (whole hours; days M T W Th F Sa Su). Empty = any time. Windows itself blocks new sign-ins outside these hours; the app also locks a session that is still open." />

                                <TextBlock Grid.Row="6" Text="Disk limit (GB)" VerticalAlignment="Center" />
                                <TextBox x:Name="QuotaBox" Grid.Row="6" Grid.Column="1" Margin="0,4" Width="120" HorizontalAlignment="Left" />
                                <TextBlock x:Name="QuotaHint" Grid.Row="7" Grid.Column="1" Style="{StaticResource Hint}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,20">
                                <Button Content="Save options (UAC)" Click="SavePolicy_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================= Shared folders ================= -->
            <TabItem Header="Shared folders">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Give other accounts access to a folder, for example a game library. Use a dedicated folder such as C:\Shared; whole drives, user profiles and system folders are refused. The app only removes the permissions it added itself." />
                        <WrapPanel Margin="0,6,0,8">
                            <Button Content="Share a folder… (UAC)" Click="ShareFolder_Click" Margin="0,0,8,0" />
                            <Button Content="Find stale shares…" Click="Stale_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Padding="10" Margin="0,8,0,0" CornerRadius="6" Background="#14808080">
                        <TextBlock TextWrapping="Wrap"
                                   Text="A shared folder is not a game licence. Each account needs its own right to play the game. Steam's official option is Steam Family Sharing; sharing one account's login breaks Steam's and Rockstar's terms, and this app never does that or signs in to any game account." />
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ListView x:Name="SharesList" SelectionMode="Single" SelectionChanged="SharesList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Folder" Width="380" DisplayMemberBinding="{Binding Path}" />
                                    <GridViewColumn Header="Accounts" Width="300" DisplayMemberBinding="{Binding Accounts}" />
                                    <GridViewColumn Header="Size warning" Width="110" DisplayMemberBinding="{Binding Warn}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock Grid.Row="1" Text="Access to the selected folder" Style="{StaticResource SectionHeader}" />
                        <ListView x:Name="GrantsList" Grid.Row="2" SelectionMode="Single">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Account" Width="160" DisplayMemberBinding="{Binding UserName}" />
                                    <GridViewColumn Header="Permission" Width="160" DisplayMemberBinding="{Binding LevelText}" />
                                    <GridViewColumn Header="Added" Width="140" DisplayMemberBinding="{Binding Added}" />
                                    <GridViewColumn Header="Note" Width="320" DisplayMemberBinding="{Binding Note}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                            <Button Content="Give another account access… (UAC)" Click="AddGrant_Click" Margin="0,0,8,8" />
                            <Button Content="Remove selected access (UAC)" Click="RemoveGrant_Click" Margin="0,0,8,8" />
                            <Button Content="Stop sharing this folder (UAC)" Click="RemoveShare_Click" Margin="0,0,8,8" />
                            <Button Content="Size warning… (UAC)" Click="ShareWarn_Click" Margin="0,0,8,8" />
                            <Button Content="Open folder" Click="OpenShare_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- ================= Storage and quotas ================= -->
            <TabItem Header="Storage and quotas">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Disk limit mode" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock x:Name="QuotaModeText" FontWeight="SemiBold" />
                        <TextBlock x:Name="QuotaModeDetail" Style="{StaticResource Hint}" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Detect and enable quota support (UAC)" Click="ProbeQuota_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Set each account's limit in Accounts → Options → Disk limit." />

                        <TextBlock Text="Storage by account" Style="{StaticResource SectionHeader}" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Measure all accounts (UAC)" Click="MeasureAll_Click" Margin="0,0,8,0" />
                            <Button Content="Measure my account" Click="MeasureMine_Click" />
                        </WrapPanel>
                    </StackPanel>
                    <ListView x:Name="StorageList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Account" Width="180" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="Profile" Width="110" DisplayMemberBinding="{Binding Profile}" />
                                <GridViewColumn Header="Shared folders it can use" Width="170" DisplayMemberBinding="{Binding Shared}" />
                                <GridViewColumn Header="Limit" Width="90" DisplayMemberBinding="{Binding Limit}" />
                                <GridViewColumn Header="Status" Width="260" DisplayMemberBinding="{Binding State}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- ================= General (personal) ================= -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource Hint}" Text="These settings are personal to your account and need no admin approval." />

                        <TextBlock Text="Open the popup with" Style="{StaticResource SectionHeader}" />
                        <RadioButton x:Name="AltTapRadio" Content="A tap of Alt on its own" GroupName="Trigger" Margin="0,2" />
                        <CheckBox x:Name="RightAltBox" Content="Also the right Alt key (leave off if you use AltGr for letters or symbols, as on Czech or Polish keyboards)" Margin="24,2,0,2" />
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <RadioButton x:Name="HotkeyRadio" Content="Shortcut:" GroupName="Trigger" VerticalAlignment="Center" />
                            <TextBox x:Name="HotkeyBox" Width="200" Margin="8,0,0,0" ToolTip="For example Ctrl+Alt+Space" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6">
                            <Button Content="Apply" Click="ApplyTrigger_Click" />
                            <TextBlock x:Name="TriggerStatus" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
                        <ComboBox x:Name="ThemeBox" Width="200" HorizontalAlignment="Left" SelectionChanged="ThemeBox_SelectionChanged">
                            <ComboBoxItem Content="Same as Windows" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>

                        <TextBlock Text="Notifications" Style="{StaticResource SectionHeader}" />
                        <CheckBox x:Name="NotifyBox" Content="Tell me when another account signs in or out" Click="NotifyBox_Click" />

                        <TextBlock Text="Start with Windows" Style="{StaticResource SectionHeader}" />
                        <TextBlock x:Name="AutostartText" TextWrapping="Wrap" />

                        <TextBlock Text="My Downloads folder" Style="{StaticResource SectionHeader}" />
                        <TextBlock x:Name="DownloadsText" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="DownloadsShareButton" Content="Use a shared folder…" Click="DownloadsShare_Click" Margin="0,0,8,8" />
                            <Button Content="Choose folder…" Click="DownloadsChoose_Click" Margin="0,0,8,8" />
                            <Button Content="Restore default" Click="DownloadsDefault_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Changes only your account. Some apps (browsers, game launchers) keep their own download folder setting." />

                        <TextBlock Text="Apps that start when I sign in" Style="{StaticResource SectionHeader}" />
                        <ListBox x:Name="AutoAppsList" Height="110" DisplayMemberPath="Command" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Add app…" Click="AddAutoApp_Click" Margin="0,0,8,8" />
                            <Button Content="Remove" Click="RemoveAutoApp_Click" Margin="0,0,8,8" />
                        </WrapPanel>

                        <TextBlock Text="Settings file" Style="{StaticResource SectionHeader}" />
                        <WrapPanel>
                            <Button Content="Export…" Click="Export_Click" Margin="0,0,8,8" />
                            <Button Content="Import… (UAC)" Click="Import_Click" Margin="0,0,8,8" />
                            <Button Content="Audit log" Click="AuditLog_Click" Margin="0,0,8,8" />
                            <Button Content="Check for updates" Click="Updates_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock x:Name="UpdateText" Style="{StaticResource Hint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= About ================= -->
            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Alt Account Switcher" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Opacity="0.75" Margin="0,2,0,8" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Windows edition" FontWeight="SemiBold" Margin="0,3" />
                            <TextBlock x:Name="EditionText" Grid.Column="1" TextWrapping="Wrap" Margin="0,3" />
                            <TextBlock Grid.Row="1" Text="Disk limit mode" FontWeight="SemiBold" Margin="0,3" />
                            <TextBlock x:Name="AboutQuotaText" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,3" />
                            <TextBlock Grid.Row="2" Text="Pro features" FontWeight="SemiBold" Margin="0,3" />
                            <TextBlock x:Name="ProText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,3" />
                            <TextBlock Grid.Row="3" Text="Shared settings" FontWeight="SemiBold" Margin="0,3" />
                            <TextBlock x:Name="ConfigText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" Margin="0,3" />
                        </Grid>

                        <TextBlock Text="Known limits" Style="{StaticResource SectionHeader}" />
                        <TextBlock TextWrapping="Wrap" xml:space="preserve">• Alt does not work on the sign-in or lock screen, and only in accounts where this app runs.
• Switch locks the PC. You always type the other account's password or PIN on the Windows sign-in screen; the app never bypasses it.
• A shared folder is not a game licence. Each account needs its own right to the game (for Steam: Steam Family Sharing, one player at a time). Sharing one account's login breaks Steam's and Rockstar's terms, and the app does not do it. Check Rockstar's own sharing options on their site.
• Daily time limits are enforced by this app only, so a determined user can close it. Sign-in hours are enforced by Windows for new sign-ins. Real parental controls need Microsoft Family Safety, which usually needs Microsoft accounts.
• Windows does not reveal current passwords or PINs, and this app never stores them.</TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
