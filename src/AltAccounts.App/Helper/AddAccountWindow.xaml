<Window x:Class="AltAccounts.App.Helper.AddAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add account (admin)" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="20">
        <TextBlock Text="New local account" Style="{StaticResource SectionHeader}" Margin="0,0,0,10" />

        <TextBlock Text="Username" />
        <TextBox x:Name="UserNameBox" Margin="0,4,0,10" MaxLength="20" />

        <TextBlock Text="Display name (optional)" />
        <TextBox x:Name="DisplayNameBox" Margin="0,4,0,10" MaxLength="64" />

        <TextBlock Text="Initial password" />
        <PasswordBox x:Name="PasswordBox1" Margin="0,4,0,10" />
        <TextBlock Text="Type the password again" />
        <PasswordBox x:Name="PasswordBox2" Margin="0,4,0,10" />

        <TextBlock Text="Account type" />
        <ComboBox x:Name="TypeBox" Margin="0,4,0,10" SelectedIndex="0">
            <ComboBoxItem Content="Standard (recommended)" />
            <ComboBoxItem Content="Admin" />
        </ComboBox>

        <TextBlock Style="{StaticResource Hint}"
                   Text="The password goes to Windows once and is never stored, shown or logged by this app. The new user can change it later in Settings &gt; Accounts &gt; Sign-in options, and set a PIN there." />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerText}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="0,0,8,0" />
            <Button x:Name="CreateButton" Content="Create account" IsDefault="True" MinWidth="130" Click="Create_Click" />
        </StackPanel>
    </StackPanel>
</Window>
