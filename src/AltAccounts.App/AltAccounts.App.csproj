<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AltAccounts</AssemblyName>
    <RootNamespace>AltAccounts.App</RootNamespace>
    <Version>1.0.1</Version>
    <Product>Alt Account Switcher</Product>
    <Company>AltAccounts</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AltAccounts.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- No single-file compression: compressed assemblies are unpacked into memory, which doubled the tray app's RAM (161 MB vs 81 MB private). The installer compresses the download instead. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray NotifyIcon and its menu; avoid type-name clashes with WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AltAccounts.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AltAccounts.Core\AltAccounts.Core.csproj" />
  </ItemGroup>

</Project>
